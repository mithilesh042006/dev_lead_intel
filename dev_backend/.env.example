# --- Required ---
APIFY_API_TOKEN=
# One of these, matching LLM_MODEL below.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional (add when you reach that stage) ---
# OUTSCRAPER_API_KEY=
# GOOGLE_MAPS_API_KEY=

# --- LLM ---
LLM_PROVIDER=auto
LLM_MODEL=gpt-5.4-mini

# --- Cost controls: these govern your free-tier burn rate ---
MAX_PLACES_PER_SEARCH=10
MAX_REVIEWS_PER_PLACE=20
REVIEWS_SORT=lowestRanking
MAX_LLM_REVIEWS_PER_BUSINESS=12

# --- Local ---
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/out
CACHE_ENABLED=true
WEBSITE_TIMEOUT=12
WEBSITE_MAX_PAGES=3

# Postgres (Neon). Leave empty to disable saving sessions.
DATABASE_URL=

# Browser origins allowed to call this API (comma-separated).
# Must name the deployed frontend once it is live — there is no wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
