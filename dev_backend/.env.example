# --- Required ---
APIFY_API_TOKEN=
GEMINI_API_KEY=

# --- Optional (add when you reach that stage) ---
# OUTSCRAPER_API_KEY=
# GOOGLE_MAPS_API_KEY=

# --- LLM ---
LLM_MODEL=gemini-3.6-flash

# --- Cost controls: these govern your free-tier burn rate ---
MAX_PLACES_PER_SEARCH=10
MAX_REVIEWS_PER_PLACE=20
REVIEWS_SORT=lowestRanking
MAX_LLM_REVIEWS_PER_BUSINESS=12

# --- Local ---
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/out
CACHE_ENABLED=true
WEBSITE_TIMEOUT=12
WEBSITE_MAX_PAGES=3
